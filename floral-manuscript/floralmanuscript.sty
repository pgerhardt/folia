% Original vector botanical ornament. Drawn entirely with TikZ.
\NeedsTeXFormat{LaTeX2e}[2021-06-01]
\ProvidesPackage{floralmanuscript}[2026/10/30 v1.1 Illuminated botanical borders]
\RequirePackage{tikz}
\usetikzlibrary{calc}
\definecolor{FloralInk}{HTML}{173A72}
\definecolor{FloralBlue}{HTML}{235BA2}
\definecolor{FloralPale}{HTML}{D4E2EC}
\definecolor{FloralGold}{HTML}{A4884E}
\definecolor{FloralPaper}{HTML}{FCFAF4}
\newif\ifFM@enabled \FM@enabledtrue
\newif\ifFM@paper \FM@papertrue
\newcount\FM@folio
\newcount\FM@phasecount
\newcount\FM@quotient
\newcount\FM@motif
\def\FM@seed{314159}
\pgfkeys{/floral/.is family,/floral,
 seed/.store in=\FM@seed,enabled/.is if=FM@enabled,paper/.is if=FM@paper}
\newcommand{\FloralSetup}[1]{\pgfkeys{/floral,#1}}
\newcommand{\FloralOff}{\FM@enabledfalse}
\newcommand{\FloralOn}{\FM@enabledtrue}

% Private deterministic variation never changes PGF's RNG stream.
% The authored skeleton stays fixed; individual botanical gestures vary.
\pgfmathdeclarefunction{fmnoise}{1}{%
 \pgfmathparse{.5+.5*sin(mod(#1,97)*137.508+\FM@phase)}}
\newcommand{\FM@next}{\global\advance\FM@motif by 1\relax}

% Asymmetric, curling acanthus-like blade, growing along local +x.
\def\FM@leafoutline{(0,0)
 .. controls (1.3,1.1) and (1.1,2.4) .. (3.0,3.3)
 .. controls (2.6,2.4) and (3.3,2.3) .. (4.0,2.7)
 .. controls (4.4,3.4) and (5.3,4.2) .. (6.6,4.0)
 .. controls (5.9,3.4) and (6.2,3.0) .. (7.2,3.2)
 .. controls (8.2,3.7) and (9.2,3.7) .. (10.0,3.0)
 .. controls (9.0,3.2) and (9.0,2.4) .. (9.8,2.0)
 .. controls (11.2,1.6) and (12.2,.2) .. (12.0,-2.6)
 .. controls (11.3,-.9) and (10.1,-.4) .. (9.0,-.5)
 .. controls (9.5,-1.0) and (9.4,-1.5) .. (9.3,-1.8)
 .. controls (7.4,-.8) and (7.2,-.5) .. (6.3,-.7)
 .. controls (6.7,-1.2) and (6.6,-1.7) .. (6.3,-2.1)
 .. controls (4.5,-1.3) and (4.1,-.6) .. (3.3,-.7)
 .. controls (3.6,-1.1) and (3.6,-1.4) .. (3.4,-1.6)
 .. controls (1.7,-.8) and (.7,-.2) .. (0,0) -- cycle}
\newcommand{\FM@leaf}[3]{%
 \FM@next
 \pgfmathsetmacro{\FM@bend}{#2+9*(fmnoise(\FM@motif)-.5)}
 \pgfmathsetmacro{\FM@length}{#3*(.92+.15*fmnoise(\FM@motif+11))}
 \pgfmathsetmacro{\FM@tone}{65+25*fmnoise(\FM@motif+3)}
 \begin{scope}[shift={(#1)},rotate=\FM@bend,scale=\FM@length]
  \path[fill=FloralBlue!\FM@tone!FloralPale] \FM@leafoutline;
  \begin{scope}
   \clip \FM@leafoutline;
   \path[fill=FloralInk,opacity=.30]
    (0,0).. controls (3,-.5) and (7,2.2)..(10,1.8)
    .. controls (11,1) and (12,-1)..(12,-3)--(5,-3)--cycle;
   \path[fill=FloralPale,opacity=.35]
    (.3,.3)..controls(3,1.6)and(6,3.5)..(9.3,2.6)
    ..controls(7,2.8)and(4,.6)..(2,.4)--cycle;
   \foreach \v in {1,...,17}{%
    \pgfmathsetmacro{\FM@vx}{.6+\v*.58}
    \pgfmathsetmacro{\FM@vy}{1.15*sin(\FM@vx*15)}
    \draw[FloralPale!65!white,line width=.055mm,opacity=.8]
     (\FM@vx,\FM@vy)..controls({\FM@vx-.2},{\FM@vy+.7})
     and({\FM@vx-.5},{\FM@vy+1.2})..({\FM@vx+.3},{\FM@vy+2.4});
    \draw[FloralPale,line width=.045mm,opacity=.65]
     (\FM@vx,\FM@vy)..controls({\FM@vx+.2},{\FM@vy-.7})
     and({\FM@vx+.3},{\FM@vy-1.2})..({\FM@vx-.2},{\FM@vy-2.4});
    \draw[FloralInk,line width=.045mm,opacity=.38]
     ({\FM@vx+.18},{\FM@vy+.2})..controls({\FM@vx+.1},{\FM@vy+1.1})
     and({\FM@vx+.4},{\FM@vy+1.7})..({\FM@vx+.6},{\FM@vy+2.7});}
  \end{scope}
  \draw[FloralInk,line width=.105mm] \FM@leafoutline;
  \draw[FloralPale!70!white,line width=.13mm]
   (.15,0)..controls(3.8,.55)and(8.9,3.15)..(11.8,-2.25);
  \draw[FloralInk!65!FloralBlue,line width=.055mm]
   (.1,-.14)..controls(4,.4)and(9.2,2.9)..(11.8,-2.3);
 \end{scope}}

% A narrow, drooping blade provides a second leaf silhouette. It also reads
% cleanly on the smallest branches, where dense serration would turn to noise.
\newcommand{\FM@blade}[3]{%
 \FM@next
 \begin{scope}[shift={(#1)},rotate={#2+6*(fmnoise(\FM@motif)-.5)},scale=#3]
  \def\FM@bladeoutline{(0,0)..controls(1.9,.9)and(2.9,2.4)..(4.6,2.6)
   ..controls(4.3,2.3)and(5.2,2.8)..(6.5,2.9)
   ..controls(6.2,2.5)and(7.4,2.9)..(8.3,2.4)
   ..controls(10.8,1.3)and(12,-1.8)..(11.5,-4.2)
   ..controls(10.9,-1.2)and(9.5,-1.4)..(7.6,-.5)
   ..controls(4.8,-.8)and(2,.2)..(0,0)--cycle}
  \path[shade,top color=FloralBlue!80!FloralPale,bottom color=FloralInk,
   draw=FloralInk,line width=.09mm]\FM@bladeoutline;
  \begin{scope}
   \clip\FM@bladeoutline;
   \path[fill=FloralInk,opacity=.30](0,0)..controls(4,.3)and(9,2)..(11.5,-4.2)
    --(12,-6)--(0,-2)--cycle;
   \foreach\v in{1,...,9}{%
    \draw[FloralPale,line width=.06mm,opacity=.7]
     ({\v*1.05},{.7*sin(\v*17)})..controls({\v*1.05+.2},1.2)
     and({\v*1.05+.3},2.2)..({\v*1.05+.7},3.1);
    \draw[FloralPale,line width=.04mm,opacity=.45]
     ({\v*1.05},{.7*sin(\v*17)})..controls({\v*1.05+.1},-.4)
     and({\v*1.05+.4},-.6)..({\v*1.05+.7},-1.5);}
  \end{scope}
  \draw[FloralPale!55!white,line width=.095mm]
   (.15,0)..controls(4,.4)and(9.5,2.6)..(11.5,-4.0);
 \end{scope}}

% Five broad notched petals with clipped washes and branching radial veins.
\def\FM@petaloutline{(0,.07)
 ..controls(-.13,.20)and(-.48,.38)..(-.49,.65)
 ..controls(-.61,.91)and(-.32,1.04)..(-.10,.94)
 ..controls(-.05,.87)and(.01,.90)..(.03,.94)
 ..controls(.15,1.06)and(.48,.99)..(.50,.77)
 ..controls(.59,.54)and(.26,.19)..(.03,.07)--cycle}
\newcommand{\FM@flower}[4]{%
 \FM@next
 \edef\FM@flowerid{\the\FM@motif}
 \begin{scope}[shift={(#1)},rotate=#3,scale=#2]
  \foreach \p in {0,...,4}{%
   \pgfmathsetmacro{\FM@turn}{72*\p+8*(fmnoise(\p+\FM@flowerid)-.5)}
   \pgfmathsetmacro{\FM@reach}{.91+.13*fmnoise(\p+\FM@flowerid+7)}
   \pgfmathsetmacro{\FM@width}{.92+.12*fmnoise(\p+\FM@flowerid+19)}
   \pgfmathsetmacro{\FM@wash}{#4+12*fmnoise(\p+\FM@flowerid+4)}
   \begin{scope}[rotate=\FM@turn,yscale=\FM@reach,xscale=\FM@width]
    \path[shade,top color=FloralInk!#4!FloralBlue,
     bottom color=FloralBlue!\FM@wash!FloralPale] \FM@petaloutline;
    \begin{scope}
     \clip \FM@petaloutline;
     \path[fill=FloralInk,opacity=.33]
      (-.58,.55)..controls(-.24,.89)and(-.29,.58)..(-.14,.76)
      ..controls(.02,.91)and(.18,.78)..(.25,.87)
      ..controls(.41,.98)and(.35,.48)..(.58,.52)
      --(.65,1.1)--(-.65,1.1)--cycle;
     \path[fill=FloralInk,opacity=.18]
      (.07,.18)..controls(.14,.56)and(.27,.60)..(.32,.91)
      ..controls(.43,.71)and(.43,.47)..(.23,.34)--cycle;
     \path[fill=FloralPale,opacity=.48]
      (-.1,.1)..controls(-.1,.37)and(-.4,.47)..(-.31,.8)
      ..controls(-.14,.67)and(-.18,.47)..(.04,.12)--cycle;
     \foreach \q in {1,...,13}{%
      \pgfmathsetmacro{\FM@px}{-.45+.90*fmnoise(\q+\FM@flowerid+\p*7)}
      \pgfmathsetmacro{\FM@py}{.38+.52*fmnoise(\q+\p*9+16)}
      \path[fill=FloralInk,opacity=.09]
       (\FM@px,\FM@py)..controls({\FM@px-.05},{\FM@py+.04})
       and({\FM@px-.03},{\FM@py+.13})..({\FM@px+.06},{\FM@py+.19})
       ..controls({\FM@px+.09},{\FM@py+.12})and({\FM@px+.02},{\FM@py+.04})..cycle;}
     \foreach \v in {-3,...,3}{%
      \pgfmathsetmacro{\FM@vx}{\v*.125}
      \pgfmathsetmacro{\FM@vs}{ifthenelse(\v<0,-1,1)}
      \draw[FloralPale!40!white,line width=.075mm,opacity=.72]
       ({\FM@vx*.10},.10)..controls({\FM@vx*.25},.33)
       and({\FM@vx*1.25},.63)..(\FM@vx,{.94-.09*abs(\v)/3})
       coordinate[pos=.55](FMveinA) coordinate[pos=.74](FMveinB);
      \draw[FloralInk,line width=.045mm,opacity=.6]
       ({\FM@vx*.42+.012},.36)..controls({\FM@vx*1.1+.012},.57)
       and({\FM@vx+.02},.75)..({\FM@vx+.04},.92);
      \draw[FloralPale,line width=.05mm,opacity=.60]
       (FMveinA)..controls+({\FM@vs*.04},.025)and+(-.02,-.02)
       ..({\FM@vx+\FM@vs*.06},{.66+.03*fmnoise(\v+5)});
      \draw[FloralPale,line width=.045mm,opacity=.55]
       (FMveinB)..controls+({\FM@vs*.035},.02)and+(-.02,-.02)
       ..({\FM@vx+\FM@vs*.055},{.83+.02*fmnoise(\v+15)});}
     \foreach \v in {-7,...,7}{%
      \draw[FloralInk,line width=.06mm,opacity=.43]
       ({\v*.065},.98)..controls({\v*.065+.01},.91)
       and({\v*.064},.87)..({\v*.062},{.80+.035*fmnoise(\v+12)});}
    \end{scope}
    \draw[FloralInk,line width=.10mm] \FM@petaloutline;
    \ifnum\p=3
     \path[fill=FloralPale!85!FloralPaper,draw=FloralBlue,line width=.06mm]
      (.49,.78)..controls(.54,.6)and(.4,.43)..(.26,.31)
      ..controls(.38,.52)and(.36,.65)..(.49,.78);
    \fi
   \end{scope}}
  \path[fill=FloralPaper] (0,0) circle[radius=.135];
  \foreach \a in {0,30,...,330}{%
   \draw[FloralPaper,line width=.12mm] (\a:.075)--({\a+5}:.31);
   \draw[FloralInk,line width=.065mm] (\a:.04)--({\a+5}:.20);
   \fill[FloralInk] ({\a+5}:.20) circle[radius=.016];}
  \foreach \a in {18,90,...,306}{%
   \fill[FloralGold] (\a:.075) circle[radius=.022];}
  \fill[FloralInk] (0,0) circle[radius=.025];
 \end{scope}}

% Meadow florets are simpler and smaller than the focal corollas.
\newcommand{\FM@floret}[3]{%
 \begin{scope}[shift={(#1)},scale=#2,rotate=#3]
  \foreach \a in {0,72,...,288}{%
   \path[rotate=\a,fill=FloralBlue!75!FloralPale,draw=FloralInk,line width=.055mm]
    (0,0)..controls(-.4,.3)and(-.43,.85)..(-.05,.84)
    ..controls(.3,1)and(.43,.3)..(0,0);
   \draw[rotate=\a,FloralPale,line width=.055mm](0,.12)--(-.02,.63);}
  \fill[FloralPaper] (0,0) circle[radius=.16];
  \fill[FloralInk] (0,0) circle[radius=.07];
 \end{scope}}
\newcommand{\FM@bud}[3]{%
 \begin{scope}[shift={(#1)},rotate=#2,scale=#3]
  \path[fill=FloralBlue!70!FloralPale,draw=FloralInk,line width=.09mm]
   (0,0)..controls(-1.8,1)and(-1.4,3.1)..(-.2,3.5)
   ..controls(1.5,3.2)and(1.5,1)..(0,0);
  \draw[FloralPale,line width=.1mm](0,.2)..controls(-.5,1.5)and(.1,2.7)..(-.2,3.2);
  \draw[FloralInk,line width=.10mm](-.9,1.2)--(0,0)--(.9,1.3);
 \end{scope}}

% Compound umbels, including visibly joined pedicels.
\newcommand{\FM@umbel}[3]{%
 \begin{scope}[shift={(#1)},rotate=#2,scale=#3]
  \draw[FloralInk,line width=.15mm]
   (0,0)..controls(-1.2,3)and(2.4,4.5)..(1,7.5);
  \foreach \j in {-3,...,3}{%
   \pgfmathsetmacro{\FM@ux}{1+\j*1.8}
   \pgfmathsetmacro{\FM@uy}{13.2-.28*\j*\j}
   \draw[FloralInk!85!FloralBlue,line width=.085mm]
    (1,7.5)..controls({1+\j*.2},9)and({\FM@ux-.5},{\FM@uy-1})..(\FM@ux,\FM@uy);
   \foreach \k in {-1,0,1}{%
    \draw[FloralBlue,line width=.065mm]
     (\FM@ux,\FM@uy)--({\FM@ux+\k*.7},{\FM@uy+1.2-abs(\k)*.25});
    \FM@floret{{\FM@ux+\k*.7},{\FM@uy+1.2-abs(\k)*.25}}{.38}{\k*20}}
  }
  \FM@blade{.5,5.2}{155}{.24}
  \FM@blade{.3,3.2}{40}{.22}
 \end{scope}}

% Every side stem starts on the actual cubic axis of this bowed spray.
\newcommand{\FM@spray}[3]{%
 \FM@next
 \edef\FM@sprayid{\the\FM@motif}
 \begin{scope}[shift={(#1)},rotate=#2,scale=#3]
  \draw[FloralInk,line width=.115mm]
   (0,0)..controls(4,5)and(-3,10)..(1,16);
  \foreach \j in {1,...,6}{%
   \pgfmathsetmacro{\FM@t}{\j*.12}
   \path (0,0)..controls(4,5)and(-3,10)..(1,16)
    coordinate[pos=\FM@t](FMtwig);
   \pgfmathsetmacro{\FM@side}{ifthenelse(mod(\j,2)==0,1,-1)}
   \pgfmathsetmacro{\FM@tx}{\FM@side*(3.2+1.1*fmnoise(\j+\FM@sprayid))}
   \pgfmathsetmacro{\FM@ty}{\j*1.9+3}
   \draw[FloralBlue,line width=.075mm]
    (FMtwig)..controls+(\FM@side*1.8,1.5)and+(-\FM@side*.7,-1.5)..(\FM@tx,\FM@ty)
    coordinate[pos=.65](FMtip);
   \FM@floret{\FM@tx,\FM@ty}{.58}{\j*31}
   \draw[FloralBlue,line width=.065mm](FMtip)--++(\FM@side*1.2,.7) coordinate(FMtipend);
   \FM@floret{FMtipend}{.36}{\j*13}
   \FM@blade{FMtwig}{ifthenelse(mod(\j,2)==0,32,148)}{.15}
  }
  \FM@floret{1,16}{.55}{12}
 \end{scope}}

% Each cubic supplies exact branch origins at three positions along its axis.
\newcommand{\FM@axis}[6]{%
 \draw[FloralInk,line width=#6mm,line cap=round]
  (#2)..controls(#3)and(#4)..(#5)
  coordinate[pos=.23](#1a) coordinate[pos=.52](#1b) coordinate[pos=.80](#1c);
 \draw[FloralBlue!65!FloralPale,line width={#6*.32mm},line cap=round]
  (#2)..controls(#3)and(#4)..(#5);}
\newcommand{\FM@curl}[3]{%
 \begin{scope}[shift={(#1)},rotate=#2,scale=#3]
  \draw[FloralBlue,line width=.085mm]
   (0,0)..controls(4,1)and(7,4)..(6,7)
   ..controls(5,10)and(1,9)..(2,6.8)
   ..controls(2.6,5.5)and(4.6,6.7)..(3.6,7.5);
 \end{scope}}
\newcommand{\FM@star}[2]{%
 \begin{scope}[shift={(#1)},scale=#2]
  \path[fill=FloralGold] (0,2.4)--(.24,.28)--(1.6,0)--(.24,-.28)
   --(0,-2.4)--(-.24,-.28)--(-1.6,0)--(-.24,.28)--cycle;
  \draw[FloralGold,line width=.085mm](-1.2,-1.2)--(1.2,1.2)(-1.2,1.2)--(1.2,-1.2);
  \fill[FloralPaper](0,0)circle[radius=.14];
 \end{scope}}
\newcommand{\FM@diamond}[2]{%
 \draw[FloralGold,line width=.10mm](#1,{#2+.8})--({#1+.48},#2)
  --(#1,{#2-.8})--({#1-.48},#2)--cycle;}

