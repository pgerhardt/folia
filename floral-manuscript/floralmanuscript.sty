\newcommand{\FM@draw}{%
 \begingroup
 \global\FM@motif=0\relax
 \FM@phasecount=\FM@seed\relax
 \advance\FM@phasecount by \numexpr\FM@folio*7919\relax
 \FM@quotient=\FM@phasecount \divide\FM@quotient by 997
 \advance\FM@phasecount by \numexpr-\FM@quotient*997\relax
 \pgfmathsetmacro{\FM@phase}{\the\FM@phasecount+.618034*\the\FM@quotient}
 \begin{tikzpicture}[remember picture,overlay,x=1mm,y=1mm,line join=round,line cap=round]
  \begin{scope}[shift={(current page.south west)}]
   \pgfmathsetmacro{\FM@H}{\paperheight/1mm}
   \pgfmathsetmacro{\FM@W}{\paperwidth/1mm}
   \pgfmathsetmacro{\FM@vertical}{(\FM@H-42)/255}
   \ifFM@paper\fill[FloralPaper](0,0)rectangle(\FM@W,\FM@H);\fi
   \begin{scope}
    % One L-shaped safety boundary, wholly outside the reserved text block.
    \clip(7,8)--({\FM@W-10},8)--({\FM@W-10},30)--(44,30)
     --(44,{\FM@H-10})--(7,{\FM@H-10})--cycle;
    \begin{scope}[shift={(0,15)},yscale=\FM@vertical]
     \FM@border
